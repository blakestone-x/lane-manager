{
  "name": "lane-manager",
  "version": "0.2.0",
  "description": "Multi-lane orchestrator that tiles concurrent Claude Agent SDK sessions side-by-side in a terminal UI",
  "type": "module",
  "bin": {
    "lane-manager": "./dist/index.js",
    "lm": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "launch": "npm run build --silent && node dist/index.js",
    "setup": "npm install && npm run build && npm link",
    "smoke": "node scripts/smoke-session.mjs && node scripts/smoke-multi.mjs",
    "clean": "rimraf dist",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "claude",
    "claude-code",
    "claude-agent-sdk",
    "anthropic",
    "agent",
    "tui",
    "ink",
    "orchestrator",
    "multi-session"
  ],
  "author": "blakestone-x",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.207",
    "commander": "^12.1.0",
    "ink": "^5.0.1",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "react": "^18.3.1",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.12",
    "@types/uuid": "^10.0.0",
    "rimraf": "^6.0.1",
    "tsx": "^4.23.1",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
